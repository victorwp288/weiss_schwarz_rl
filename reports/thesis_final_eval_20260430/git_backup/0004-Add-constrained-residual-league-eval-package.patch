+schema_version: 2
+description: Thesis v17 radical B1-base trainable residual adapter with hard B1 guard.
+experiment:
+  role: main
+system:
+  profile:
+    training: fast
+    local_iteration: fast
+    ci_invariant_testing: debug
+  mp_start_method: spawn
+  learner_device: cuda:auto
+  actor_device: cuda:auto
