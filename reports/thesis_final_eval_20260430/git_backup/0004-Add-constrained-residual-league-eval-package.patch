+  envs_per_actor: 8
+  total_envs: 96
+  actor_torch_threads: 1
+  learner_torch_threads: 16
+  actor_queue_capacity_unrolls: 256
+  learner_prefetch_batches: 4
+  collection_backend: process
+model:
+  gru_hidden_size: 512
+  encoder_mlp_width: 512
